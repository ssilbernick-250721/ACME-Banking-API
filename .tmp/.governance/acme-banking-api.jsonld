],
"doc:transformed": false
},
{
"@id": "#208",
"@type": [
"doc:ExternalDomainElement",
"doc:DomainElement"
],
"doc:raw": "components:\r\n  headers:\r\n    Cache-Control:\r\n      description: |\r\n        Activates caching and defines cache behavior through cache response directives. \r\n        \r\n        Usually defines public or private (cacheable by proxy or not) and max-age for resource. \r\n        \r\n        See https://tools.ietf.org/html/rfc7234#section-5.2 for more information.\r\n      schema:\r\n        type: string\r\n        example: private, max-age=31536000\r\n      required: true\r\n    Expires:\r\n      description: |\r\n        Sets a date in ISO 8601 format(default) from which the cached resource should no longer be considered valid. \r\n        \r\n        If both the Expires header and max-age in the Cache-Control header are set, max-age will take precedence.\r\n      schema:\r\n        type: string\r\n        format: date-time\r\n        example: 2020-08-03T09:30:55Z\r\n      required: true  ",
"core:mediaType": "application/yaml",
"sourcemaps:sources": [
{
"@id": "#208/source-map"
}
]
},
