"doc:raw": "components:\r\n  responses:\r\n    PostResponse:\r\n      description: Created\r\n      headers:\r\n        Location:\r\n          description: URL of the new customer\r\n          schema:\r\n            type: string\r\n            example: /customers/8f19cb50-3f56-4d38\r\n          required: true\r\n    \r\n    ErrorResponse:\r\n      description: Service Unavailable\r\n      content:\r\n        application/json:\r\n          schema:\r\n            $ref: \"#/components/schemas/CustomErrorMessage\"\r\n  \r\n  securitySchemes:\r\n    CustomToken:\r\n      type: apiKey\r\n      in: header\r\n      name: Authorization\r\n      description: This header should contain a valid security token\r\n\r\n    OAuth2:\r\n      type: oauth2\r\n      flows:\r\n        authorizationCode:\r\n          authorizationUrl: https://hostname/services/oauth2/authorize\r\n          tokenUrl: https://hostname/services/oauth2/token\r\n          scopes: {}\r\n      description: Apply the OAuth 2.0 security policy to resource methods for authenticating API requests.\r\n",
"core:mediaType": "application/yaml",
"sourcemaps:sources": [
{
"@id": "#205/source-map"
}
]
},
{
"@id": "#204",
