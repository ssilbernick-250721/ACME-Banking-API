"@type": [
"apiContract:Parameter",
"core:Parameter",
"doc:DomainElement"
],
"core:name": "Cache-Control",
"core:description": "Activates caching and defines cache behavior through cache response directives. \n\nUsually defines public or private (cacheable by proxy or not) and max-age for resource. \n\nSee https://tools.ietf.org/html/rfc7234#section-5.2 for more information.\n",
"apiContract:required": true,
"apiContract:style": "simple",
"apiContract:explode": false,
"apiContract:binding": "header",
"raml-shapes:schema": {
"@id": "#242"
},
"sourcemaps:sources": [
