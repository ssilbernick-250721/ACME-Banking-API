"@id": "#241/source-map"
}
]
},
{
"@id": "#245",
"@type": [
"apiContract:Parameter",
"core:Parameter",
"doc:DomainElement"
],
"core:name": "Expires",
"core:description": "Sets a date in ISO 8601 format(default) from which the cached resource should no longer be considered valid. \n\nIf both the Expires header and max-age in the Cache-Control header are set, max-age will take precedence.\n",
"apiContract:required": true,
"apiContract:style": "simple",
"apiContract:explode": false,
"apiContract:binding": "header",
"raml-shapes:schema": {
"@id": "#246"
},
"sourcemaps:sources": [
{
"@id": "#245/source-map"
}
]
